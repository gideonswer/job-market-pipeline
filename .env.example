# Copy to .env and fill in. Never commit .env.

# Leave empty to use local SQLite (data/jobs.db).
# Local Docker Postgres:  postgresql+psycopg://jobs:jobs@localhost:5432/jobs
# Neon / Supabase:        paste their connection string
DATABASE_URL=

# LLMs (both have free tiers). Groq is tried first, Gemini second.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# https://developer.adzuna.com/  (free)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

SEARCH_TERMS=AI engineer,machine learning engineer,data scientist,generative AI,LLM engineer
MAX_PAGES_PER_TERM=2
EXTRACT_LIMIT=100
LLM_DELAY_SECONDS=2
